# Anthropic — chat model
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Voyage AI — embeddings (Phase 1+)
VOYAGE_API_KEY=pa-your-voyage-key-here

# Supabase — server-side (used by Next route handlers)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase — client-safe (used by browser via NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optipeople auth API (the /auth-api/* proxy forwards here)
OPTIPEOPLE_API_TARGET=https://api-staging.optipeople.dk

# Comma-separated list of Optipeople emails allowed to use /admin and
# /api/admin/* (super-admins). Empty / unset = nobody.
SUPER_ADMIN_EMAILS=mpg@optipeople.dk
